      "position": [
        360,
        40
      ]
    },
    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "={{ $json.results[0].latitude }}"
            },
            {
              "name": "longitude",
              "value": "={{ $json.results[0].longitude }}"
            },
            {
              "name": "current",
              "value": "temperature_2m,wind_speed_10m"
            }
          ]
        },
        "options": {}
      },
      "id": "bfdb387d-a953-447e-8784-499c2b7886c3",
