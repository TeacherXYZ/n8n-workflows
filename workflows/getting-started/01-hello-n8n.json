      "position": [
        -80,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "// ✏️ YOUR TURN: change the city names (keep the quotes \"\" and commas).\n// Add as many cities as you like.\nconst cities = [\"Kassel\", \"Copenhagen\"];\n\n// Every city becomes one \"item\". The next nodes run once per item.\nreturn cities.map(city => ({ json: { city } }));"
      },
      "id": "41382157-102c-4ead-b7ce-db86c223ca26",
      "name": "Our cities",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        140,
        40
      ]
    },
    {
      "parameters": {
        "url": "https://geocoding-api.open-meteo.com/v1/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "={{ $json.city }}"
            },
            {
              "name": "count",
              "value": "1"
            },
            {
              "name": "language",
              "value": "en"
            }
          ]
        },
        "options": {}
      },
      "id": "6deb6d8f-a575-45fa-b669-f4d9df28e746",
      "name": "Find city on the map",
